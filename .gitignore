/target
# Agent-harness state (worktrees it creates while working on this repo). The gate
# skips it as tool state; git should not offer to commit it either.
.claude/
**/*.rs.bk
.DS_Store
# Cargo.lock is COMMITTED on purpose — reproducible builds are the thesis.

# pub stage's work directory (publication engine); never source.
/publish/.out/
# The verified lane (`targo trust check`) writes a per-crate verification cache under
# crates/<crate>/target/trust-cache even when CARGO_TARGET_DIR points elsewhere.
/crates/*/target/
